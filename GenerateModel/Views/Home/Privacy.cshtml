@model DatabaseTypeMapping

@{
    ViewData["Title"] = "Database Type Mapping";
}

<style>
    .div-scroll {
        height: 700px;
        overflow-y: auto;
    }
</style>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/2.2.4/jquery.min.js"></script>
<script src="~/jquery.table2excel.js"></script>

<h2 class="mb-4">Database Type Mapping</h2>

<!-- Bootstrap Tabs -->
<ul class="nav nav-tabs" id="databaseTabs" role="tablist">
    <li class="nav-item">
        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#sqlserver">SQL Server</button>
    </li>
    <li class="nav-item">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#postgresql">PostgreSQL</button>
    </li>
    <li class="nav-item">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#mysql">MySQL</button>
    </li>
    <li class="nav-item">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#oracle">Oracle</button>
    </li>
</ul>

<!-- Tab Content -->
<div class="tab-content mt-3">
    <!-- SQL Server -->
    <div class="tab-pane fade show active" id="sqlserver">
        <div style="text-align:right">
            <button class="btn btn-success mb-2" onclick="exportTableToExcel('sqlserverTable', 'SQLServer')">Export to Excel</button>
        </div>

        <div class="div-scroll">
            <table id="sqlserverTable" class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>SQL Server Type</th>
                        <th>C# Type</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.SQLServer)
                    {
                        <tr>
                            <td>@item.Key</td>
                            <td>@item.Value</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>

    <!-- PostgreSQL -->
    <div class="tab-pane fade" id="postgresql">
        <div style="text-align:right">
            <button class="btn btn-success mb-2" onclick="exportTableToExcel('postgresqlTable', 'PostgreSQL')">Export to Excel</button>
        </div>
        <div class="div-scroll">
            <table id="postgresqlTable" class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>PostgreSQL Type</th>
                        <th>C# Type</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.PostgreSQL)
                    {
                        <tr>
                            <td>@item.Key</td>
                            <td>@item.Value</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>

    <!-- MySQL -->
    <div class="tab-pane fade" id="mysql">
        <div style="text-align:right">
            <button class="btn btn-success mb-2" onclick="exportTableToExcel('mysqlTable', 'MySQL')">Export to Excel</button>
        </div>
        <div class="div-scroll">
            <table id="mysqlTable" class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>MySQL Type</th>
                        <th>C# Type</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.MySQL)
                    {
                        <tr>
                            <td>@item.Key</td>
                            <td>@item.Value</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>

    <!-- Oracle -->
    <div class="tab-pane fade" id="oracle">
        <div style="text-align:right">
            <button class="btn btn-success mb-2" onclick="exportTableToExcel('oracleTable', 'Oracle')">Export to Excel</button>
        </div>
        <div class="div-scroll">
            <table id="oracleTable" class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Oracle Type</th>
                        <th>C# Type</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Oracle)
                    {
                        <tr>
                            <td>@item.Key</td>
                            <td>@item.Value</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>
</div>


<script src="~/table2excel/table2excel.js"></script>
<script src="~/table2excel/xlsx.full.min.js"></script>


<script type="text/javascript">
    function exportTableToExcel(tableId, filename) {

    var table = document.getElementById(tableId);
                var ws = XLSX.utils.table_to_sheet(table, { sheet: filename, dateNF: 'yyyy-mm-dd;@@', cellDates: true, raw: true });
                var wb = XLSX.utils.book_new();
                XLSX.utils.book_append_sheet(wb, ws, filename);
                XLSX.writeFile(wb, filename + ".xlsx");
    }

</script>
